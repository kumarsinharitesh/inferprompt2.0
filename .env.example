# Environment Variables Template — InferPrompt

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/inferprompt

# --- Authentication ---
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# --- Server ---
NODE_ENV=development
PORT=3001

# --- Razorpay (Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret

# --- Email (Gmail SMTP) ---
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- Frontend Base URL (used by React) ---
VITE_API_BASE_URL=http://localhost:3001

# --- LLM API Keys (user-supplied; these are optional platform keys, also stored per-user in browser) ---
VITE_SARVAM_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openrouter/free
VITE_OPENROUTER_RISK_MODEL=liquid/lfm-2.5-1.2b-instruct:free
VITE_GEMINI_API_KEY=
