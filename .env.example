# InferPrompt local environment
# Copy this file to .env, replace the placeholder values, and keep .env private.

# Application server
NODE_ENV=development
PORT=3001

# Database
# Create a MongoDB database and paste its connection string here.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/inferprompt

# Authentication
# Use a long, unique random string in every environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email for account verification and password reset
# For Gmail, use an App Password instead of your normal account password.
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
# Production alternative (recommended on Render): verify this sending address
# in Resend, then set both values in Render's environment settings.
RESEND_API_KEY=
EMAIL_FROM=your_verified_sender@example.com

# Razorpay test-mode keys for purchasing credits
# Never use live keys while developing or demoing the project.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_test_secret

# Local frontend URL. This is useful for local development and callbacks.
VITE_API_BASE_URL=http://localhost:3001

# Optional platform LLM keys
# Add only the providers you want to make available by default. Users can also
# enter their own provider keys in the Keys panel; those values are not stored here.
SARVAM_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional OpenRouter model override. The free router is the default.
VITE_OPENROUTER_MODEL=openrouter/free
